rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function estaAutenticado() {
      return request.auth != null;
    }

    function tienePerfil() {
      return estaAutenticado() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function esAdminOLogistica() {
      return tienePerfil() && (
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
        get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'logistica'
      );
    }

    match /usuarios/{userId} {
      allow read: if estaAutenticado();
      allow create, update: if estaAutenticado();
      allow delete: if false;
    }

    match /activos/{activoId} {
      allow read: if estaAutenticado();
      allow create, update: if estaAutenticado();
      allow delete: if false;
    }

    match /revisiones/{revisionId} {
      allow read: if estaAutenticado();
      allow create, update: if estaAutenticado();
      allow delete: if false;
    }

    match /express_loans/{loanId} {
      allow read: if esAdminOLogistica();
      allow create, update: if esAdminOLogistica();
      allow delete: if false;
    }

    match /consecutivos/{docId} {
      allow read, write: if false;
    }

    match /auditoria/{logId} {
      allow read: if estaAutenticado();
      allow write: if false;
    }
  }
}
