rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasProfile() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    function currentUserProfile() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    function hasManagedAccess() {
      return hasProfile() &&
        request.auth.token.active == true &&
        currentUserProfile().activo == true &&
        request.auth.token.role is string &&
        currentUserProfile().rol == request.auth.token.role;
    }

    function isAdmin() {
      return hasManagedAccess() && request.auth.token.role == 'admin';
    }

    function isLogistica() {
      return hasManagedAccess() && request.auth.token.role == 'logistica';
    }

    function isCustodio() {
      return hasManagedAccess() && request.auth.token.role == 'custodio';
    }

    function isAdminOrLogistica() {
      return isAdmin() || isLogistica();
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function formalActaData(actaId) {
      return get(/databases/$(database)/documents/actas_formales/$(actaId)).data;
    }

    function canManageFormalActa(actaId) {
      return isAdmin() ||
        (isLogistica() && formalActaData(actaId).creadoPor == request.auth.uid);
    }

    function isValidPublicSignatureUpdate() {
      return request.auth == null &&
        resource.data.estado == 'pendiente' &&
        request.resource.data.estado == 'firmada' &&
        request.resource.data.actaId == resource.data.actaId &&
        request.resource.data.asistenteId == resource.data.asistenteId &&
        request.resource.data.nombre == resource.data.nombre &&
        request.resource.data.cargo == resource.data.cargo &&
        request.resource.data.declaracionAceptada == true &&
        request.resource.data.metodoFirma in ['firma_touch', 'imagen', 'clave'] &&
        request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'estado',
          'metodoFirma',
          'firmaDataUrl',
          'claveFirma',
          'declaracionAceptada',
          'fechaFirma',
          'userAgent',
          'actualizadoEn'
        ]) &&
        (
          (
            request.resource.data.metodoFirma in ['firma_touch', 'imagen'] &&
            request.resource.data.firmaDataUrl is string &&
            request.resource.data.firmaDataUrl.matches('^data:image/')
          ) ||
          (
            request.resource.data.metodoFirma == 'clave' &&
            request.resource.data.claveFirma is string &&
            request.resource.data.claveFirma.size() >= 3
          )
        );
    }

    match /usuarios/{userId} {
      allow read: if isOwner(userId) || isAdminOrLogistica();
      allow create, update, delete: if false;
    }

    match /activos/{activoId} {
      allow read: if isAdminOrLogistica() ||
        (isCustodio() && resource.data.custodioId == request.auth.uid);
      allow create, update: if isAdminOrLogistica();
      allow delete: if false;
    }

    match /revisiones/{revisionId} {
      allow read: if isAdminOrLogistica() ||
        (isCustodio() && resource.data.custodioId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /asignaciones/{assignmentId} {
      allow read: if isAdminOrLogistica() ||
        (isCustodio() && resource.data.custodioId == request.auth.uid);
      allow create, update, delete: if false;
    }

    match /express_loans/{loanId} {
      allow read: if isAdminOrLogistica();
      allow create, update, delete: if false;
    }

    match /actas_formales/{actaId} {
      allow read: if isAdmin() ||
        (hasManagedAccess() && resource.data.creadoPor == request.auth.uid);
      allow create: if isAdminOrLogistica() &&
        request.resource.data.creadoPor == request.auth.uid;
      allow update: if canManageFormalActa(actaId);
      allow delete: if false;

      match /firmantes/{tokenId} {
        allow get: if true;
        allow list: if canManageFormalActa(actaId);
        allow create: if canManageFormalActa(actaId);
        allow update: if canManageFormalActa(actaId) || isValidPublicSignatureUpdate();
        allow delete: if false;
      }
    }

    match /consecutivos/{docId} {
      allow read, write: if false;
    }

    match /auditoria/{logId} {
      allow read, write: if false;
    }
  }
}
