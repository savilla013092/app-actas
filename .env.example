# Firebase Configuration
# Copia este archivo como .env.local y completa los valores
# IMPORTANTE: Estas mismas variables deben configurarse en Vercel

NEXT_PUBLIC_FIREBASE_API_KEY=tu-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=tu-proyecto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=tu-proyecto
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=tu-proyecto.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789:web:abcdef

# Agente de actas con IA (solo servidor: NO usar prefijo NEXT_PUBLIC_)
# Se usa Gemini (Google AI Studio, nivel gratuito). Sin GEMINI_API_KEY el modo
# "Nota IA" cae automaticamente al parser determinista.
GEMINI_API_KEY=
# Modelo de Gemini para extraer datos de la nota. Default: gemini-2.5-flash-lite (nivel gratuito).
GEMINI_MODEL=gemini-2.5-flash-lite

# Opcional: service account (JSON o base64) para operaciones privilegiadas de firebase-admin.
# La verificacion del ID token en /api/actas/extraer funciona solo con el projectId,
# por lo que esta variable es opcional.
FIREBASE_ADMIN_CREDENTIALS=

# Secreto para la ruta de seed de demo (solo desarrollo)
SEED_DEMO_SECRET=
