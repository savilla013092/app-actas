rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasManagedAccess() {
      return isSignedIn() &&
        request.auth.token.active == true &&
        request.auth.token.role is string;
    }

    function isAdmin() {
      return hasManagedAccess() && request.auth.token.role == 'admin';
    }

    function isLogistica() {
      return hasManagedAccess() && request.auth.token.role == 'logistica';
    }

    function isCustodio() {
      return hasManagedAccess() && request.auth.token.role == 'custodio';
    }

    function isAdminOrLogistica() {
      return isAdmin() || isLogistica();
    }

    function isSupportedEvidenceImage() {
      return request.resource.contentType == 'image/jpeg' ||
        request.resource.contentType == 'image/png';
    }

    function revisionExists(revisionId) {
      return firestore.exists(/databases/(default)/documents/revisiones/$(revisionId));
    }

    function revisionDoc(revisionId) {
      return firestore.get(/databases/(default)/documents/revisiones/$(revisionId)).data;
    }

    function isOpenRevisionState(revisionId) {
      return revisionExists(revisionId) &&
        (revisionDoc(revisionId).estado == 'borrador' ||
          revisionDoc(revisionId).estado == 'pendiente_firma_custodio');
    }

    function isRevisionCustodian(revisionId) {
      return isCustodio() &&
        revisionExists(revisionId) &&
        revisionDoc(revisionId).custodioId == request.auth.uid;
    }

    function assignmentExists(assignmentId) {
      return firestore.exists(/databases/(default)/documents/asignaciones/$(assignmentId));
    }

    function assignmentDoc(assignmentId) {
      return firestore.get(/databases/(default)/documents/asignaciones/$(assignmentId)).data;
    }

    function isOpenAssignmentState(assignmentId) {
      return assignmentExists(assignmentId) &&
        (assignmentDoc(assignmentId).estado == 'borrador' ||
          assignmentDoc(assignmentId).estado == 'pendiente_firma_custodio');
    }

    function isAssignmentCustodian(assignmentId) {
      return isCustodio() &&
        assignmentExists(assignmentId) &&
        assignmentDoc(assignmentId).custodioId == request.auth.uid;
    }

    match /evidencias/{revisionId}/{fileName} {
      allow read: if isAdminOrLogistica() || isRevisionCustodian(revisionId);
      allow write: if isAdminOrLogistica() &&
        isOpenRevisionState(revisionId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        isSupportedEvidenceImage();
      allow delete: if isAdminOrLogistica() &&
        revisionExists(revisionId) &&
        revisionDoc(revisionId).estado == 'borrador';
    }

    match /firmas/{revisionId}/{fileName} {
      allow read: if isAdminOrLogistica() || isRevisionCustodian(revisionId);

      allow write: if fileName == 'revisor.png' &&
        isAdminOrLogistica() &&
        revisionExists(revisionId) &&
        revisionDoc(revisionId).estado == 'borrador' &&
        request.resource.size < 500 * 1024 &&
        request.resource.contentType == 'image/png';

      allow write: if fileName == 'custodio.png' &&
        isRevisionCustodian(revisionId) &&
        revisionDoc(revisionId).estado == 'pendiente_firma_custodio' &&
        request.resource.size < 500 * 1024 &&
        request.resource.contentType == 'image/png';
    }

    match /asignaciones-evidencias/{assignmentId}/{fileName} {
      allow read: if isAdminOrLogistica() || isAssignmentCustodian(assignmentId);
      allow write: if isAdminOrLogistica() &&
        isOpenAssignmentState(assignmentId) &&
        request.resource.size < 5 * 1024 * 1024 &&
        isSupportedEvidenceImage();
    }

    match /asignaciones-firmas/{assignmentId}/{fileName} {
      allow read: if isAdminOrLogistica() || isAssignmentCustodian(assignmentId);

      allow write: if fileName == 'revisor.png' &&
        isAdminOrLogistica() &&
        assignmentExists(assignmentId) &&
        assignmentDoc(assignmentId).estado == 'borrador' &&
        request.resource.size < 500 * 1024 &&
        request.resource.contentType == 'image/png';

      allow write: if fileName == 'custodio.png' &&
        isAssignmentCustodian(assignmentId) &&
        assignmentDoc(assignmentId).estado == 'pendiente_firma_custodio' &&
        request.resource.size < 500 * 1024 &&
        request.resource.contentType == 'image/png';
    }

    match /express_loans/{loanId}/{fileName} {
      allow read: if isAdminOrLogistica();
      allow write: if isAdminOrLogistica() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /imports/asset-imports/{userId}/{fileName} {
      allow read: if isAdmin();
      allow write: if isAdmin() && request.auth.uid == userId &&
        request.resource.size < 20 * 1024 * 1024 &&
        (
          request.resource.contentType == 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet' ||
          request.resource.contentType == 'application/vnd.ms-excel'
        );
    }

    match /actas/{fileName} {
      allow read: if hasManagedAccess();
      allow write: if false;
    }

    match /institucional/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
