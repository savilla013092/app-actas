rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function estaAutenticado() {
      return request.auth != null;
    }

    function esAdminOLogistica() {
      return estaAutenticado() &&
        firestore.exists(/databases/(default)/documents/usuarios/$(request.auth.uid)) && (
          firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin' ||
          firestore.get(/databases/(default)/documents/usuarios/$(request.auth.uid)).data.rol == 'logistica'
        );
    }

    match /evidencias/{revisionId}/{fileName} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /firmas/{revisionId}/{fileName} {
      allow read: if estaAutenticado();
      allow write: if estaAutenticado() &&
        request.resource.size < 500 * 1024 &&
        request.resource.contentType == 'image/png';
    }

    match /express_loans/{loanId}/{fileName} {
      allow read: if esAdminOLogistica();
      allow write: if esAdminOLogistica() &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/.*');
    }

    match /actas/{fileName} {
      allow read: if estaAutenticado();
      allow write: if false;
    }

    match /institucional/{fileName} {
      allow read: if true;
      allow write: if false;
    }
  }
}
